{
  "manifest_version": "0.1.0",
  "servers": [
    {
      "server_id": "github",
      "transport": "stdio",
      "dynamism": "live_read",
      "sandbox": false,
      "description": "GitHub \u2014 real repo state: issues, PRs, commits, file contents.",
      "tags": [
        "credentialed",
        "tier:credentialed",
        "pkg:npm",
        "domain:dev"
      ],
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "requires_env": [
        "GITHUB_PERSONAL_ACCESS_TOKEN"
      ]
    },
    {
      "server_id": "brave_search",
      "transport": "stdio",
      "dynamism": "live_read",
      "sandbox": false,
      "description": "Brave Search \u2014 real web search results.",
      "tags": [
        "credentialed",
        "tier:credentialed",
        "pkg:npm",
        "domain:search"
      ],
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "requires_env": [
        "BRAVE_API_KEY"
      ]
    },
    {
      "server_id": "tavily",
      "transport": "stdio",
      "dynamism": "live_read",
      "sandbox": false,
      "description": "Tavily \u2014 research-flavored web search/answer API.",
      "tags": [
        "credentialed",
        "tier:credentialed",
        "pkg:npm",
        "domain:search"
      ],
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp"
      ],
      "requires_env": [
        "TAVILY_API_KEY"
      ]
    },
    {
      "server_id": "exa",
      "transport": "stdio",
      "dynamism": "live_read",
      "sandbox": false,
      "description": "Exa \u2014 semantic web search (find pages by meaning).",
      "tags": [
        "credentialed",
        "tier:credentialed",
        "pkg:npm",
        "domain:search"
      ],
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "requires_env": [
        "EXA_API_KEY"
      ]
    },
    {
      "server_id": "firecrawl",
      "transport": "stdio",
      "dynamism": "live_read",
      "sandbox": false,
      "description": "Firecrawl \u2014 scrape/crawl JS-rendered sites.",
      "tags": [
        "credentialed",
        "tier:credentialed",
        "pkg:npm",
        "domain:web-scraping"
      ],
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp-server"
      ],
      "requires_env": [
        "FIRECRAWL_API_KEY"
      ]
    },
    {
      "server_id": "linear",
      "transport": "stdio",
      "dynamism": "live_read",
      "sandbox": false,
      "description": "Linear \u2014 real issue tracker: issues, status, comments.",
      "tags": [
        "credentialed",
        "tier:credentialed",
        "pkg:npm",
        "domain:productivity"
      ],
      "command": "npx",
      "args": [
        "-y",
        "linear-mcp"
      ],
      "requires_env": [
        "LINEAR_API_KEY"
      ]
    },
    {
      "server_id": "notion",
      "transport": "stdio",
      "dynamism": "live_read",
      "sandbox": false,
      "description": "Notion \u2014 real workspace pages: read/write/search.",
      "tags": [
        "credentialed",
        "tier:credentialed",
        "pkg:npm",
        "domain:productivity"
      ],
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "requires_env": [
        "NOTION_API_KEY"
      ]
    },
    {
      "server_id": "slack",
      "transport": "stdio",
      "dynamism": "live_read",
      "sandbox": false,
      "description": "Slack \u2014 real messaging: post, list channels, history.",
      "tags": [
        "credentialed",
        "tier:credentialed",
        "pkg:npm",
        "domain:communication"
      ],
      "command": "npx",
      "args": [
        "-y",
        "slack-workspace-mcp-server"
      ],
      "requires_env": [
        "SLACK_BOT_TOKEN"
      ]
    },
    {
      "server_id": "supabase",
      "transport": "stdio",
      "dynamism": "live_read",
      "sandbox": false,
      "description": "Supabase \u2014 real Postgres + auth + storage.",
      "tags": [
        "credentialed",
        "tier:credentialed",
        "pkg:npm",
        "domain:data"
      ],
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase"
      ],
      "requires_env": [
        "SUPABASE_ACCESS_TOKEN",
        "SUPABASE_PROJECT_REF"
      ]
    }
  ]
}