{
  "manifest_version": "0.1.0",
  "servers": [
    {
      "server_id": "time",
      "transport": "stdio",
      "command": ".venv/bin/python",
      "args": ["-m", "mcp_server_time", "--local-timezone", "UTC"],
      "dynamism": "static",
      "description": "Time and timezone queries (mcp-server-time).",
      "tags": ["time", "utility"]
    },
    {
      "server_id": "fetch",
      "transport": "stdio",
      "command": ".venv/bin/python",
      "args": ["-m", "mcp_server_fetch"],
      "dynamism": "live_read",
      "description": "HTTP fetch and Markdown extraction (mcp-server-fetch).",
      "tags": ["http", "web"]
    },
    {
      "server_id": "git",
      "transport": "stdio",
      "command": ".venv/bin/python",
      "args": ["-m", "mcp_server_git", "--repository", "/tmp/dmcp-sandbox-repo"],
      "dynamism": "stateful_write",
      "sandbox": true,
      "description": "Git operations confined to /tmp/dmcp-sandbox-repo (mcp-server-git).",
      "tags": ["git", "vcs", "sandboxed"]
    },
    {
      "server_id": "sqlite",
      "transport": "stdio",
      "command": ".venv/bin/mcp-server-sqlite",
      "args": ["--db-path", "/tmp/dmcp-sandbox/bench.db"],
      "dynamism": "stateful_write",
      "sandbox": true,
      "description": "SQLite database CRUD against /tmp/dmcp-sandbox/bench.db (mcp-server-sqlite).",
      "tags": ["database", "sql", "sandboxed"]
    },
    {
      "server_id": "fs",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/private/tmp/dmcp-fs-sandbox"],
      "dynamism": "stateful_write",
      "sandbox": true,
      "description": "Filesystem read/write/move confined to /private/tmp/dmcp-fs-sandbox (Node MCP server).",
      "tags": ["filesystem", "files", "sandboxed"]
    },
    {
      "server_id": "memory",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {"MEMORY_FILE_PATH": "/private/tmp/dmcp-memory/store.json"},
      "dynamism": "stateful_write",
      "sandbox": true,
      "description": "Knowledge graph (entities/relations/observations) persisted at /private/tmp/dmcp-memory/store.json.",
      "tags": ["memory", "knowledge-graph", "sandboxed"]
    },
    {
      "server_id": "wikipedia",
      "transport": "stdio",
      "command": ".venv/bin/wikipedia-mcp",
      "args": [],
      "dynamism": "live_read",
      "description": "Wikipedia search, page retrieval, summaries, links, and coordinates (wikipedia-mcp).",
      "tags": ["wikipedia", "knowledge", "public-api"]
    },
    {
      "server_id": "arxiv",
      "transport": "stdio",
      "command": ".venv/bin/arxiv-mcp-server",
      "args": ["--storage-path", "/private/tmp/dmcp-arxiv"],
      "dynamism": "live_read",
      "sandbox": true,
      "description": "arXiv paper search, abstract retrieval, and PDF download to /private/tmp/dmcp-arxiv (arxiv-mcp-server).",
      "tags": ["arxiv", "papers", "research", "public-api"]
    },
    {
      "server_id": "yfinance",
      "transport": "stdio",
      "command": ".venv/bin/yfinance-mcp",
      "args": [],
      "dynamism": "live_read",
      "description": "Yahoo Finance ticker search, lookup, historical data, earnings, options, sector data (yfinance-mcp).",
      "tags": ["finance", "stocks", "public-api"]
    },
    {
      "server_id": "osm",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@cyanheads/openstreetmap-mcp-server"],
      "dynamism": "live_read",
      "description": "OpenStreetMap geocoding, reverse geocoding, lookup, nearby/bbox/raw Overpass queries (cyanheads).",
      "tags": ["maps", "geocoding", "public-api"]
    },
    {
      "server_id": "wikidata",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@cyanheads/wikidata-mcp-server"],
      "dynamism": "live_read",
      "description": "Wikidata entity search, statements, labels, sitelinks, and SPARQL query (cyanheads).",
      "tags": ["wikidata", "knowledge-graph", "public-api"]
    },
    {
      "server_id": "worldbank",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@cyanheads/worldbank-mcp-server"],
      "dynamism": "live_read",
      "description": "World Bank Open Data: topics, countries, indicators, time series (cyanheads).",
      "tags": ["economics", "open-data", "public-api"]
    },
    {
      "server_id": "eurostat",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@cyanheads/eurostat-mcp-server"],
      "dynamism": "live_read",
      "description": "Eurostat dataset search, themes, dimensions, and query (cyanheads).",
      "tags": ["economics", "open-data", "europe", "public-api"]
    },
    {
      "server_id": "crossref",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@cyanheads/crossref-mcp-server"],
      "dynamism": "live_read",
      "description": "Crossref scholarly works, references, journals, funders (cyanheads).",
      "tags": ["citations", "research", "public-api"]
    },
    {
      "server_id": "openlibrary",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@cyanheads/openlibrary-mcp-server"],
      "dynamism": "live_read",
      "description": "Open Library books/works/editions/authors/subjects/covers (cyanheads).",
      "tags": ["books", "library", "public-api"]
    },
    {
      "server_id": "pubmed",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@cyanheads/pubmed-mcp-server"],
      "dynamism": "live_read",
      "description": "PubMed article search, fetch, full text, citations, MeSH lookup (cyanheads).",
      "tags": ["medicine", "research", "public-api"]
    }
  ]
}
