# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Only OPENROUTER_API_KEY is required for the core pipeline.

# --- Required -------------------------------------------------------------
OPENROUTER_API_KEY=

# --- Optional: credentialed MCP servers (Bucket A) ------------------------
# Only needed if you run servers that require auth. Full signup instructions:
# docs/credentials_bucket_a.md. Leave blank unless you use the given server.

# Knowledge / search / web
GITHUB_PERSONAL_ACCESS_TOKEN=
BRAVE_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Productivity / SaaS
LINEAR_API_KEY=
NOTION_TOKEN=
SLACK_BOT_TOKEN=
DISCORD_TOKEN=
AIRTABLE_API_KEY=
JIRA_HOST=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Email
RESEND_API_KEY=
SENDGRID_API_KEY=

# Databases (live)
SUPABASE_ACCESS_TOKEN=
NEON_API_KEY=
MONGODB_URI=

# Observability / DevOps
SENTRY_AUTH_TOKEN=
CLOUDFLARE_API_TOKEN=
